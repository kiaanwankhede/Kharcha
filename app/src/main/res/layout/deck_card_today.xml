<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: today's spend. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <TextView
        style="@style/WidgetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today" />

    <TextView
        android:id="@+id/today_amount"
        style="@style/WidgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="44sp" />

    <TextView
        android:id="@+id/today_count"
        style="@style/WidgetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/today_waiting"
        style="@style/WidgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_warn"
        android:textSize="14sp" />
</LinearLayout>
