<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: safe to spend today. Also the widget-picker preview, hence the sample text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="12dp">

    <TextView
        style="@style/WidgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="36dp"
        android:text="Safe to spend today" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/safe_amount"
            style="@style/WidgetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="₹1,150"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/safe_cash"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="+ Cash"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/safe_bar"
        style="@style/WidgetBar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:progress="71" />

    <ProgressBar
        android:id="@+id/safe_bar_over"
        style="@style/WidgetBar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:progress="100"
        android:progressDrawable="@drawable/widget_bar_orange"
        android:visibility="gone" />

    <TextView
        android:id="@+id/safe_caption"
        style="@style/WidgetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="₹42,380 of ₹60,000 this month"
        android:textSize="12sp" />
</LinearLayout>
