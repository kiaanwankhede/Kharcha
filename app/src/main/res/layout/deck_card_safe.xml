<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card: safe to spend today against the monthly limit. Also the widget-picker preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <TextView
        style="@style/WidgetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Safe to spend today" />

    <TextView
        android:id="@+id/safe_amount"
        style="@style/WidgetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="₹1,150"
        android:textSize="40sp" />

    <ProgressBar
        android:id="@+id/safe_bar"
        style="@style/WidgetBar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:progress="71" />

    <ProgressBar
        android:id="@+id/safe_bar_over"
        style="@style/WidgetBar"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:progress="100"
        android:progressDrawable="@drawable/widget_bar_orange"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/safe_caption"
            style="@style/WidgetLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="₹42,380 of ₹60,000 this month"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/safe_cash"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="+ Cash"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
