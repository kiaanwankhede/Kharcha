<?xml version="1.0" encoding="utf-8"?>
<!--
  The deck: a list of cards, each as tall as the widget, so you scroll through them one at a time.
  The ⌄ button scrolls to the next card.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ListView
        android:id="@+id/deck"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/deck_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg"
        android:gravity="center"
        android:padding="16dp"
        android:text="Open Kharcha to get started"
        android:textColor="@color/widget_text"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/deck_next"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/widget_next_bg"
        android:contentDescription="Next card"
        android:scaleType="center"
        android:src="@drawable/ic_widget_next" />
</FrameLayout>
