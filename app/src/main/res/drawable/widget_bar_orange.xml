<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded progress bar for the home-screen widget. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#2E3953" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="#F08A5D" /><corners android:radius="4dp" /></shape></clip>
    </item>
</layer-list>
