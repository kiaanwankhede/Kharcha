<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own Google backup (Android 12+). The passphrase is tied to this phone's keystore
     and cannot be restored elsewhere, so it is left out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="kharcha_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="kharcha_secure.xml" />
    </device-transfer>
</data-extraction-rules>
